<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: the stage colour with the U mark. The
     Flutter splash (lib/features/splash) starts on this exact frame. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#0F0D0C</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#0F0D0C</item>
        <item name="android:navigationBarColor">#0F0D0C</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
